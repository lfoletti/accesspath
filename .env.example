# Modèle de configuration locale : copier en .env (non versionné) et remplir.

# Dossier des données écrites par --save (défaut : ./data du dossier courant)
# ACCESSPATH_DATA=data

# Collecteurs d'un projet de collecte, branchés sur `sap verify` et `warmup`
# ACCESSPATH_SITES=mon_projet.sites

# Fichier complet des motifs de sites (défaut : la vue publique livrée)
# ACCESSPATH_PATTERNS=data/websites.yaml

# Corpus annoté pour le prior kNN de `inspect` (défaut : data/sap_training_corpus.json)
# ACCESSPATH_CORPUS=data/sap_training_corpus.json

# Collecte déjà faite, comparée par `sap batch --mode contents`
# ACCESSPATH_CONTENTS_ROOT=/chemin/vers/les/archives
